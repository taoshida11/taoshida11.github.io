{
  "name": "taoshida-academic-homepage",
  "version": "0.8.1.1",
  "description": "Shida Tao's academic personal homepage. SHe is from VIPL, Institute of Computing Technology, Chinese Academy of Sciences, with research interests in embodied AI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoshida11/taoshida11.github.io"
  },
  "keywords": [
    "jekyll",
    "academic homepage",
    "personal website",
    "embodied ai",
    "robotics"
  ],
  "contributors": [
    "Shida Tao"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/taoshida11/taoshida11.github.io/issues"
  },
  "homepage": "https://taoshida11.github.io",
  "engines": {
    "node": ">= 0.10.0"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "jslint": "^0.12.1",
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}